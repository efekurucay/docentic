OPENROUTER_API_KEY=
MODEL=openrouter/free
FALLBACK_MODEL=deepseek/deepseek-v4-flash
ALLOWED_ORIGINS=example.com,localhost
PORT=8080
RATE_LIMIT_PER_MIN=20
MAX_TURNS=8
SITE_CACHE_TTL_MIN=60

# Contact notifications: set either the Telegram pair, or a generic
# CONTACT_WEBHOOK (Discord/ntfy/etc, POSTed {text,content,message,...}).
# TELEGRAM_BOT_TOKEN takes priority over CONTACT_WEBHOOK if both are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_WEBHOOK=
